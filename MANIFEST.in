# Include documentation
include README.md
include LICENSE
include CONTRIBUTING.md
include EXAMPLES.md
include CHANGELOG.md
include INSTALL.md

# Include configuration files
include pyproject.toml
include setup_venv.py

# Include tests
recursive-include tests *.py

# Exclude unwanted files
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude *.so
global-exclude .DS_Store

# data/ holds the sample signals, under their own license (data/LICENSE), and
# local downloads: never packaged
prune data
# Exclude generated files (data/ledger holds operator data: never packaged)
prune data/ledger
# README/docs images are served from GitHub by absolute URL: never packaged
prune assets
prune htmlcov
prune .pytest_cache
prune .mypy_cache
prune build
prune dist
prune *.egg-info
